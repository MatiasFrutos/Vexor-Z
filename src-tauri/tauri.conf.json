{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vexor",
  "version": "0.6.1",
  "identifier": "dev.vexor.terminal",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Vexor",
        "width": 1200,
        "height": 760,
        "minWidth": 480,
        "minHeight": 320,
        "label": "main",
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}